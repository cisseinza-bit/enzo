# Serveur
PORT=3001
NODE_ENV=development

# Base de données PostgreSQL
DATABASE_URL=postgres://coach:coach@127.0.0.1:5432/coach

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# Anthropic (optionnel) — si absent, le générateur déterministe est utilisé.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stripe (optionnel) — si absent, les routes billing renvoient un mode "désactivé".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_YEARLY=

# CORS — origine du frontend
CORS_ORIGIN=http://localhost:5173
